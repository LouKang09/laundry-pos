{
  "name": "@laundry/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "generate": "prisma generate",
    "migrate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file-if-exists=../.env prisma/seed.js",
    "admin:setup": "node --env-file-if-exists=../.env src/setup-admin.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
